# LLM_PROVIDER: claude | chatgpt
LLM_PROVIDER=claude

# Claude 사용 시
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# ChatGPT/OpenAI 사용 시
# LLM_PROVIDER=chatgpt
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini

# 컨테이너 실행 사용자 — 볼륨 파일 권한을 호스트 사용자와 일치시킴
# 값 확인: id -u && id -g
HOST_UID=1000
HOST_GID=1000
