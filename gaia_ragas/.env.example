# LLM_PROVIDER: claude | chatgpt
LLM_PROVIDER=claude

# Claude 사용 시
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# ChatGPT/OpenAI 사용 시
# LLM_PROVIDER=chatgpt
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini
# OPENAI_MAX_OUTPUT_TOKENS=4096        # 응답 출력 토큰 상한
# OPENAI_REASONING_EFFORT=minimal      # GPT-5/o 계열 reasoning effort: minimal | medium | high
# LLM_MODEL=                           # 모델 직접 지정 (미설정 시 CLAUDE_MODEL/OPENAI_MODEL 사용)

# HuggingFace (모델 다운로드 시 rate limit 방지용, 선택 사항)
# HUGGING_FACE_HUB_TOKEN=hf_...

# Cohesity GAIA API (eval_pipeline.py --step evaluate 시 필요)
# Helios: Settings > Access Management > API Keys 에서 생성
COHESITY_CLUSTER_URL=https://<helios-fqdn>
COHESITY_API_KEY=<api-key>
COHESITY_DATASET_NAME=<dataset-name>

# 컨테이너 실행 사용자 — 볼륨 파일 권한을 호스트 사용자와 일치시킴
# 값 확인: id -u && id -g
HOST_UID=1000
HOST_GID=1000
