# LLM_PROVIDER: claude | chatgpt
LLM_PROVIDER=claude

# Claude 사용 시
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# ChatGPT/OpenAI 사용 시
# LLM_PROVIDER=chatgpt
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini

# HuggingFace private/gated 모델 접근 시 설정 (공개 모델은 불필요)
HUGGING_FACE_HUB_TOKEN=

# ── 임베딩 모델 ──────────────────────────────────────────────────────────────
# 모델 변경 시 EMBED_DIMENSION도 반드시 함께 수정
# 예) jhgan/ko-sroberta-multitask  → 768
#     snunlp/KR-ELECTRA-discriminator → 768
#     Qwen/Qwen3-Embedding-8B          → 4096  (GPU 필수)
EMBED_MODEL=jhgan/ko-sroberta-multitask
EMBED_DIMENSION=768

# GPU당 한 번에 임베딩할 문장 수 (VRAM 여유에 맞게 조정)
# 소형 모델(768d): 128~256 / 대형 모델(8B): 16~64
EMBED_BATCH_SIZE=64

# ── 텍스트 청킹 ──────────────────────────────────────────────────────────────
# CHUNK_SIZE: 청크 글자 수 (길수록 문맥 풍부, 짧을수록 정밀 검색)
# CHUNK_OVERLAP: 청크 간 오버랩 글자 수 (문맥 연속성 유지)
# MIN_CHUNK_LENGTH: 이 글자 수 미만 청크는 버림
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MIN_CHUNK_LENGTH=50

# 분리 우선순위 (JSON 배열, 앞쪽부터 순서대로 시도)
# 기본: 단락("\n\n") → 줄바꿈("\n") → 일본식마침표("。") → 마침표(".") → 공백(" ") → 글자단위("")
CHUNK_SEPARATORS=["\n\n", "\n", "。", ".", " ", ""]

# 분리자를 청크에 포함할지 여부 (true/false)
CHUNK_KEEP_SEPARATOR=false

# CHUNK_SEPARATORS를 정규식으로 해석할지 여부 (true/false)
# 예: CHUNK_SEPARATORS=["\\n{2,}", "[.。!?]\\s"] 와 함께 true 설정
CHUNK_SEPARATOR_REGEX=false

# ── 검색 ─────────────────────────────────────────────────────────────────────
# 벡터 검색 시 반환할 문서 수 (RAG 컨텍스트 크기에 영향)
TOP_K=5

# 하이브리드 검색 (BM25 sparse + Dense 벡터 RRF 퓨전)
# true: BM25+Dense 결합 (권장) / false: Dense 단독
# 변경 시 --reset 재인제스트 필요 (컬렉션 스키마가 바뀜)
USE_HYBRID_SEARCH=true
BM25_MODEL=Qdrant/bm25

# ── 인제스트 로그 ────────────────────────────────────────────────────────────
# output/ingest.log 에 기록하는 간격 (처리 파일 수 기준)
LOG_INTERVAL=1000

# ── GPU ──────────────────────────────────────────────────────────────────────
# 단일 GPU 번호 (nvidia-smi로 확인)
# --gpus 옵션 사용 시 run.sh에서 직접 지정하므로 이 값은 무시됨
CUDA_VISIBLE_DEVICES=2

# embed-server가 사용할 GPU 번호 (인제스트 GPU와 다른 번호 권장)
EMBED_SERVER_GPU=0

# ── 컨테이너 실행 사용자 ─────────────────────────────────────────────────────
# 볼륨 파일 권한을 호스트 사용자와 일치시킴
# 값 확인: id -u && id -g
HOST_UID=1000
HOST_GID=1000
