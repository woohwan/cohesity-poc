ANTHROPIC_API_KEY=sk-ant-...

# HuggingFace private/gated 모델 접근 시 설정 (공개 모델은 불필요)
HUGGING_FACE_HUB_TOKEN=

# 임베딩 모델 (기본값: jhgan/ko-sroberta-multitask, 768차원)
# 모델 변경 시 EMBED_DIMENSION도 반드시 함께 수정
EMBED_MODEL=jhgan/ko-sroberta-multitask
EMBED_DIMENSION=768

# 컨테이너 실행 사용자 — 볼륨 파일 권한을 호스트 사용자와 일치시킴
# 값 확인: id -u && id -g
HOST_UID=1000
HOST_GID=1000
